.header {
  padding: 28rpx 4rpx 8rpx;
}

.title {
  display: block;
  color: #1c1917;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.2;
}

.subtitle {
  display: block;
  margin-top: 14rpx;
  color: #78716c;
  font-size: 28rpx;
  line-height: 1.5;
}

.settings-card {
  margin-top: 26rpx;
  padding: 28rpx;
}

.card-title {
  display: block;
  color: #1c1917;
  font-size: 32rpx;
  font-weight: 800;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f5f5f4;
}

.row:last-child {
  border-bottom: 0;
}

.row-label {
  color: #78716c;
  font-size: 28rpx;
}

.row-value {
  max-width: 430rpx;
  color: #292524;
  font-size: 28rpx;
  text-align: right;
  word-break: break-all;
}

.paragraph {
  display: block;
  margin-top: 18rpx;
  color: #57534e;
  font-size: 28rpx;
  line-height: 1.65;
}
